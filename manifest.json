{
  "manifest_version": 3,
  "name": "steamarket",
  "version": "0.1.0",
  "description": "Agrupa itens do inventário Steam, mostra histórico de preços e ajuda a vender em lote.",
  "icons": {
    "16": "icons/icone-16.png",
    "32": "icons/icone-32.png",
    "48": "icons/icone-48.png",
    "96": "icons/icone-96.png",
    "128": "icons/icone-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "steam-vendas@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://prices.csgotrader.app/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*/inventory*",
        "https://steamcommunity.com/profiles/*/inventory*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icone-16.png",
      "32": "icons/icone-32.png",
      "48": "icons/icone-48.png",
      "96": "icons/icone-96.png",
      "128": "icons/icone-128.png"
    },
    "default_title": "steamarket"
  }
}
