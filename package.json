{
  "name": "steamarket",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Extensão Firefox: preços, totais e venda (um a um ou em lote) no seu inventário da Steam",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "lint:ext": "web-ext lint --source-dir dist",
    "assinar": "npm run build && web-ext sign --source-dir dist --channel unlisted"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.12.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "web-ext": "^8.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaogazire/steamarket"
  },
  "engines": {
    "node": ">=22"
  }
}
